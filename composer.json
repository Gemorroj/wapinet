{
    "name": "gemorroj/wapinet",
    "description": "wapinet.ru website",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "ext-json": "*",
        "ext-pdo_mysql": "*",
        "ext-intl": "*",
        "ext-apcu": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-gd": "*",

        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.8",

        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.4",
        "symfony/asset": "8.2.*@beta",
        "symfony/console": "8.2.*@beta",
        "symfony/doctrine-messenger": "8.2.*@beta",
        "symfony/dotenv": "8.2.*@beta",
        "symfony/flex": "^2.12",
        "symfony/form": "8.2.*@beta",
        "symfony/framework-bundle": "8.2.*@beta",
        "symfony/http-client": "8.2.*@beta",
        "symfony/intl": "8.2.*@beta",
        "symfony/mailer": "8.2.*@beta",
        "symfony/mime": "8.2.*@beta",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "8.2.*@beta",
        "symfony/property-access": "8.2.*@beta",
        "symfony/property-info": "8.2.*@beta",
        "symfony/runtime": "8.2.*@beta",
        "symfony/security-bundle": "8.2.*@beta",
        "symfony/serializer": "8.2.*@beta",
        "symfony/string": "8.2.*@beta",
        "symfony/translation": "8.2.*@beta",
        "symfony/twig-bundle": "8.2.*@beta",
        "symfony/validator": "8.2.*@beta",
        "symfony/yaml": "8.2.*@beta",
        "symfony/scheduler": "8.2.*@beta",

        "twig/extra-bundle": "^3.29",
        "twig/twig": "^3.30",
        "pagerfanta/doctrine-collections-adapter": "^4.11",
        "pagerfanta/doctrine-orm-adapter": "^4.11",

        "easycorp/easyadmin-bundle": "^5.10",
        "james-heinrich/getid3": "dev-master",
        "vich/uploader-bundle": "^3.0",
        "liip/imagine-bundle": "^2.19",
        "gregwar/captcha": "^1.3",
        "tufanbarisyildirim/php-apk-parser": "dev-master",
        "geoip2/geoip2": "^3.4",
        "php-ffmpeg/php-ffmpeg": "^1.4",
        "riverline/multipart-parser": "^2.3",

        "gemorroj/whordap": "dev-master",
        "gemorroj/stop-spam": "^4.0",
        "gemorroj/archive7z": "dev-master",
        "gemorroj/m3u-parser": "^6.2",
        "gemorroj/syntax": "^4.5.1",
        "gemorroj/htmlvalidator": "^4.0",
        "gemorroj/cssvalidator": "^4.0",
        "gemorroj/xbbcode": "dev-master",
        "gemorroj/ginfo": "dev-master",
        "gemorroj/php-bittorrent": "^4.0",
        "nelmio/api-doc-bundle": "^5.14",
        "symfony/rate-limiter": "8.2.*@beta",
        "gemorroj/php-obfuscator": "dev-master",
        "symfony/expression-language": "8.2.*@beta"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.2.*@beta",
        "symfony/css-selector": "8.2.*@beta",
        "symfony/debug-bundle": "8.2.*@beta",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.2.*@beta",
        "symfony/var-dumper": "8.2.*@beta",
        "symfony/web-profiler-bundle": "8.2.*@beta",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-symfony": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-doctrine": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": false
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-apcu": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-php85": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "xbbcode-assets": "@php bin/copy-xbbcode-assets.php",
        "post-install-cmd": [
            "@auto-scripts",
            "@xbbcode-assets"
        ],
        "post-update-cmd": [
            "@auto-scripts",
            "@xbbcode-assets"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*"
        }
    }
}
