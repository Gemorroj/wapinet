{
    "name": "wapinet-frontend",
    "version": "0.0.0",
    "engines": {
        "node": ">= 26"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build --base-href / --deploy-url /app/",
        "watch": "ng build --watch --configuration development --base-href / --deploy-url /app/",
        "test": "ng test",
        "test:scripts": "node --test scripts/*.test.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "e2e": "playwright test",
        "e2e:install": "playwright install chromium",
        "icons:check": "node scripts/check-icons.mjs",
        "api:doc": "node scripts/export-openapi.mjs",
        "api:gen": "ng-openapi-gen && prettier --write \"src/app/api/generated/**/*.ts\" \"openapi.json\"",
        "api:sync": "npm run api:doc && npm run api:gen"
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^22.3.0",
        "@angular/common": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@angular/core": "^22.3.0",
        "@angular/forms": "^22.3.0",
        "@angular/platform-browser": "^22.3.0",
        "@angular/router": "^22.3.0",
        "@maskito/angular": "^5.6.1",
        "@maskito/core": "^5.6.1",
        "@maskito/kit": "^5.6.1",
        "@maskito/phone": "^5.6.1",
        "@ng-web-apis/common": "^5.4.1",
        "@ng-web-apis/intersection-observer": "^5.4.1",
        "@ng-web-apis/mutation-observer": "^5.4.1",
        "@ng-web-apis/platform": "^5.4.1",
        "@ng-web-apis/resize-observer": "^5.4.1",
        "@ng-web-apis/screen-orientation": "^5.4.1",
        "@noble/hashes": "^2.4.0",
        "@taiga-ui/cdk": "^5.32.0",
        "@taiga-ui/core": "^5.32.0",
        "@taiga-ui/design-tokens": "~0.329.0",
        "@taiga-ui/event-plugins": "^5.1.0",
        "@taiga-ui/font-watcher": "~0.7.0",
        "@taiga-ui/i18n": "^5.32.0",
        "@taiga-ui/icons": "^5.32.0",
        "@taiga-ui/kit": "^5.32.0",
        "@taiga-ui/layout": "^5.32.0",
        "@taiga-ui/polymorpheus": "^5.0.1",
        "@taiga-ui/styles": "^5.32.0",
        "highlight.js": "^11.12.0",
        "libphonenumber-js": "^1.13.16",
        "rxjs": "~7.8.2",
        "tslib": "^2.9.1"
    },
    "devDependencies": {
        "@angular/build": "^22.3.0",
        "@angular/cli": "^22.3.0",
        "@angular/compiler-cli": "^22.3.0",
        "@playwright/test": "^1.65.0",
        "jsdom": "^31.0.0",
        "less": "^4.9.1",
        "ng-openapi-gen": "^1.1.0",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "vitest": "^5.1.0"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions"
    ],
    "allowScripts": {
        "esbuild": true,
        "@parcel/watcher": false,
        "lmdb": false,
        "msgpackr-extract": false
    }
}
