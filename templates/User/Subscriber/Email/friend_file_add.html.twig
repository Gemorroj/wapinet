{% extends 'User/Subscriber/Email/_layout.html.twig' %}

{# @var file \App\Entity\File #}
{% block content %}
    {% if file.user.isFemale %}
        Ваша подруга <a href="{{ absolute_url('/') }}user/profile/{{ file.user.username }}">{{ file.user.username }}</a> добавила новый файл <a href="{{ absolute_url('/') }}files/{{ file.id }}">{{ file.originalFileName }}</a> ({{ file.fileSize|wapinet_size }}).
    {% else %}
        Ваш друг <a href="{{ absolute_url('/') }}user/profile/{{ file.user.username }}">{{ file.user.username }}</a> добавил новый файл <a href="{{ absolute_url('/') }}files/{{ file.id }}">{{ file.originalFileName }}</a> ({{ file.fileSize|wapinet_size }}).
    {% endif %}
{% endblock %}

