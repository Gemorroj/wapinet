{% extends 'User/Subscriber/Email/_layout.html.twig' %}

{% block content %}
    {% if friend.isFemale %}
        Ваша подруга <a href="{{ absolute_url('/') }}user/profile/{{ friend.username }}">{{ friend.username }}</a> удалила из друзей <a href="{{ absolute_url('/') }}user/profile/{{ friend_friend.username }}">{{ friend_friend.username }}</a>.
    {% else %}
        Ваш друг <a href="{{ absolute_url('/') }}user/profile/{{ friend.username }}">{{ friend.username }}</a> удалил из друзей <a href="{{ absolute_url('/') }}user/profile/{{ friend_friend.username }}">{{ friend_friend.username }}</a>.
    {% endif %}
{% endblock %}

