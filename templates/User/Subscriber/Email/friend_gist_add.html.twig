{% extends 'User/Subscriber/Email/_layout.html.twig' %}

{# @var gist \App\Entity\Gist #}
{% block content %}
    {% if gist.user.isFemale %}
        Ваша подруга <a href="{{ absolute_url('/') }}user/profile/{{ gist.user.username }}">{{ gist.user.username }}</a> добавила в блог новое сообщение с темой <a href="{{ absolute_url('/') }}gist/view/{{ gist.id }}">{{ gist.subject }}</a>.
    {% else %}
        Ваш друг <a href="{{ absolute_url('/') }}user/profile/{{ gist.user.username }}">{{ gist.user.username }}</a> добавил в блог новое сообщение с темой <a href="{{ absolute_url('/') }}gist/view/{{ gist.id }}">{{ gist.subject }}</a>.
    {% endif %}
{% endblock %}

