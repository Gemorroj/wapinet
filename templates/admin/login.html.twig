<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Вход в админку</title>
    <style>
        :root {
            color-scheme: light;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            display: grid;
            place-items: center;
            min-block-size: 100vh;
            margin: 0;
            background: #f4f5f7;
            color: #1f2328;
        }

        .login {
            inline-size: min(22rem, calc(100vw - 2rem));
            padding: 1.5rem;
            border: 1px solid #d0d7de;
            border-radius: 0.5rem;
            background: #fff;
        }

        h1 {
            margin: 0 0 1rem;
            font-size: 1.25rem;
        }

        .error {
            margin: 0 0 1rem;
            color: #cf222e;
            font-size: 0.875rem;
        }

        label {
            display: block;
            margin-block-end: 0.875rem;
            font-size: 0.875rem;
        }

        input {
            display: block;
            inline-size: 100%;
            margin-block-start: 0.25rem;
            padding: 0.5rem 0.625rem;
            border: 1px solid #d0d7de;
            border-radius: 0.375rem;
            font: inherit;
        }

        button {
            inline-size: 100%;
            padding: 0.5rem 0.75rem;
            border: 0;
            border-radius: 0.375rem;
            background: #0969da;
            color: #fff;
            font: inherit;
            cursor: pointer;
        }
    </style>
</head>
<body>
<main class="login">
    <h1>Вход в админку</h1>

    {% if error %}
        <p class="error">Неверный логин или пароль.</p>
    {% endif %}

    <form method="post" action="{{ path('admin_login_check') }}">
        <label>
            Логин
            <input type="text" name="_username" value="{{ last_username }}" autocomplete="username" maxlength="180" required autofocus>
        </label>

        <label>
            Пароль
            <input type="password" name="_password" autocomplete="current-password" maxlength="4096" required>
        </label>

        <input type="hidden" name="_target_path" value="{{ path('admin') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Войти</button>
    </form>
</main>
</body>
</html>
